{
  "enabledPlugins": {
    "ptbr-writer@ptbr-writer": true,
    "marola-devkit@marola-devkit": true
  },
  "extraKnownMarketplaces": {
    "ptbr-writer": {
      "source": {
        "source": "github",
        "repo": "h0ffmann/ptbr-writer"
      }
    },
    "marola-devkit": {
      "source": {
        "source": "github",
        "repo": "h0ffmann/marola-devkit"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-via-bipr.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
