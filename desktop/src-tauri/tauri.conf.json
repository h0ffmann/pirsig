{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pirsig",
  "version": "0.1.0",
  "identifier": "io.github.h0ffmann.pirsig",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
